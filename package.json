{
  "name": "aura-plus",
  "version": "1.0.0",
  "description": "Aura+ Multimodal Context-Aware Commerce Assistant",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api-matrix": "vitest run tests/integration/mcp/api-matrix.test.ts",
    "test:http": "vitest run tests/integration/mcp/http-transport.test.ts",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.693.0",
    "@fastify/cors": "9.0.1",
    "@modelcontextprotocol/sdk": "1.0.4",
    "fastify": "4.28.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
