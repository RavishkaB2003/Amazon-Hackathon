{
  "name": "aura-plus",
  "version": "1.0.0",
  "description": "Aura+ Multimodal Context-Aware Commerce Assistant",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --jsx react-jsx --noEmit",
    "test": "vitest run --config vite.config.ts",
    "test:unit": "vitest run tests/unit --config vite.config.ts",
    "test:integration": "vitest run tests/integration --config vite.config.ts",
    "test:api-matrix": "vitest run tests/integration/mcp/api-matrix.test.ts --config vite.config.ts",
    "test:http": "vitest run tests/integration/mcp/http-transport.test.ts --config vite.config.ts",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.693.0",
    "@fastify/cors": "9.0.1",
    "@modelcontextprotocol/sdk": "1.0.4",
    "fastify": "4.28.1",
    "lucide-react": "0.460.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.1",
    "vitest": "2.1.5"
  }
}
